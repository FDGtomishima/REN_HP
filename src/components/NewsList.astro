---
// NEWS 記事の一覧（日付・カテゴリ・タイトル）。HOME の最新情報と NEWS 一覧で共用する
import type { CollectionEntry } from 'astro:content';
import { formatDate, isoDate } from '../lib/news';

interface Props {
	posts: CollectionEntry<'news'>[];
}

const { posts } = Astro.props;
---

<ul class="news-list">
	{
		posts.map((post) => (
			<li data-category={post.data.category}>
				<a href={`/news/${post.id}/`}>
					<time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
					<span class="category">{post.data.category}</span>
					<span class="title">{post.data.title}</span>
				</a>
			</li>
		))
	}
</ul>

<style>
	.news-list {
		margin: 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--line, var(--color-line));
	}

	li[hidden] {
		display: none;
	}

	li {
		border-bottom: 1px solid var(--line, var(--color-line));
	}

	a {
		display: grid;
		grid-template-columns: auto auto 1fr;
		align-items: baseline;
		gap: 8px 20px;
		padding-block: 16px;
		color: inherit;
		text-decoration: none;
	}

	a:hover .title {
		text-decoration: underline;
	}

	time {
		font-variant-numeric: tabular-nums;
	}

	.category {
		padding: 0 10px;
		border: 1px solid currentColor;
		border-radius: 999px;
		font-size: 0.75rem;
		white-space: nowrap;
	}

	/* スマホ：日付・カテゴリの下にタイトル */
	@media (max-width: 599px) {
		a {
			grid-template-columns: auto 1fr;
		}

		.category {
			justify-self: start;
		}

		.title {
			grid-column: 1 / -1;
		}
	}
</style>
